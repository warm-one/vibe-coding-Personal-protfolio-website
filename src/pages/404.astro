---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { defaultLang, locales } from "../i18n/ui";
import { localizePath, useTranslations } from "../i18n/utils";

const blocks = locales.map((locale) => ({
  locale,
  t: useTranslations(locale),
}));

const t = useTranslations(defaultLang);
const tEn = useTranslations("en");
---

<BaseLayout
  lang={defaultLang}
  title={t("notFoundTitle")}
  description={t("notFoundBlurb")}
  noindex
  nav="minimal"
  footer={false}
>
  <section
    id="not-found"
    class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28"
    data-title-en={tEn("notFoundTitle") + " · " + SITE.name}
    data-blurb-en={tEn("notFoundBlurb")}
  >
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
      <span data-404-lang="zh" lang="zh-CN">{t("notFoundTitle")}</span>
      <span data-404-lang="en" lang="en">{tEn("notFoundTitle")}</span>
    </h1>
    {
      blocks.map(({ locale, t: tr }) => (
        <div data-404-lang={locale} lang={locale === "zh" ? "zh-CN" : "en"}>
          <p class="mt-4 text-muted">{tr("notFoundBlurb")}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={localizePath("/", locale)}
              class="inline-flex items-center rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-90"
            >
              {tr("backHome")}
            </a>
            <a
              href={localizePath("/projects", locale)}
              class="inline-flex items-center rounded-md border border-border px-4 py-2.5 text-sm font-medium text-muted transition-colors hover:border-accent/60 hover:text-foreground"
            >
              {tr("navProjects")}
            </a>
          </div>
        </div>
      ))
    }
  </section>
  <script is:inline>
    (() => {
      if (document.documentElement.dataset.locale !== "en") return;
      const section = document.getElementById("not-found");
      if (!section) return;
      document.title = section.getAttribute("data-title-en") || document.title;
      const description = document.querySelector('meta[name="description"]');
      if (description) {
        description.setAttribute(
          "content",
          section.getAttribute("data-blurb-en") || "",
        );
      }
    })();
  </script>
</BaseLayout>
