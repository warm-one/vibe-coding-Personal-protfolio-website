---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" description="你要找的页面不存在。">
  <section class="mx-auto max-w-3xl px-4 py-24 sm:px-6">
    <p class="text-sm font-medium text-accent">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
      页面走丢了
    </h1>
    <p class="mt-4 text-muted">你要找的页面不存在，或者已经被移动。</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-md bg-accent px-4 py-2 font-medium text-background transition-opacity hover:opacity-90"
    >
      回到首页
    </a>
  </section>
</BaseLayout>
