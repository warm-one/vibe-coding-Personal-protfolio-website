---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/Tag.astro";
import CopyEmail from "../../components/CopyEmail.astro";
import { SITE } from "../../consts";
import { getProjects, collectTags } from "../../lib/projects";
import { projectTypeLabelKey } from "../../lib/categories";
import { formatMonth } from "../../lib/format";
import {
  getLangFromUrl,
  getLangStaticPaths,
  localizePath,
  useTranslations,
} from "../../i18n/utils";

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = await getProjects(lang);
const selected = projects.slice(0, 3);
const tags = collectTags(projects).slice(0, 8);
const stack = SITE.skills.length > 0 ? SITE.skills : tags;
---

<BaseLayout
  lang={lang}
  title={t("aboutTitle")}
  description={t("aboutMeta")}
>
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 sm:py-20">
    <div class="grid gap-8 lg:grid-cols-[20rem_1fr] lg:items-start">
      <div
        class="rounded-2xl border border-border bg-surface p-6 lg:sticky lg:top-24"
      >
        <img
          src={SITE.avatar}
          alt={SITE.name}
          width="96"
          height="96"
          class="h-24 w-24 rounded-full border border-border"
        />
        <h1 class="mt-5 text-2xl font-bold tracking-tight">{SITE.name}</h1>
        <p class="mt-1 text-sm text-muted">{SITE.role[lang]}</p>
        <p class="mt-4 text-sm text-pretty text-muted">{SITE.bio[lang]}</p>

        <div class="mt-6 flex flex-col items-start gap-3">
          <a
            href={"mailto:" + SITE.email}
            class="inline-block py-1 text-sm font-medium text-accent hover:underline"
          >
            {SITE.email}
          </a>
          <CopyEmail
            email={SITE.email}
            copyLabel={t("copyEmail")}
            copiedLabel={t("copied")}
          />
        </div>

        <ul class="mt-4 flex flex-wrap gap-3 text-sm text-muted">
          {
            SITE.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  class="inline-block py-1 transition-colors hover:text-accent"
                  target={social.href.startsWith("http") ? "_blank" : undefined}
                  rel={
                    social.href.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                >
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="space-y-10">
        {
          selected.length > 0 && (
            <div>
              <h2 class="text-lg font-semibold">{t("featuredTitle")}</h2>
              <ul class="mt-3 divide-y divide-border overflow-hidden rounded-xl border border-border bg-surface">
                {selected.map((project) => (
                  <li>
                    <a
                      href={localizePath("/projects/" + project.slug, lang)}
                      class="group flex items-center justify-between gap-4 p-4 transition-colors hover:bg-background"
                    >
                      <span class="min-w-0">
                        <span class="block font-medium transition-colors group-hover:text-accent">
                          {project.entry.data.title}
                        </span>
                        <span class="mt-0.5 block text-xs text-muted">
                          {t(projectTypeLabelKey(project.entry.data.type))} ·{" "}
                          {formatMonth(project.entry.data.date)}
                        </span>
                      </span>
                      <span
                        class="shrink-0 text-muted transition-transform motion-safe:group-hover:translate-x-0.5"
                        aria-hidden="true"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          stack.length > 0 && (
            <div>
              <h2 class="text-lg font-semibold">{t("aboutStack")}</h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {stack.map((item) => (
                  <Tag label={item} />
                ))}
              </div>
            </div>
          )
        }

        {
          SITE.experience.length > 0 && (
            <div>
              <h2 class="text-lg font-semibold">{t("aboutExperience")}</h2>
              <ul class="mt-3 space-y-6">
                {SITE.experience.map((item) => (
                  <li class="border-l border-border pl-4">
                    <p class="font-medium">
                      {item.role} · {item.company}
                    </p>
                    <p class="mt-1 text-sm text-muted">{item.period}</p>
                    {item.summary && (
                      <p class="mt-2 text-sm text-muted">{item.summary}</p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div id="contact">
          <h2 class="text-lg font-semibold">{t("contactTitle")}</h2>
          <p class="mt-2 text-muted">{t("contactBlurb")}</p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <a
              href={"mailto:" + SITE.email}
              class="inline-block py-1 text-accent hover:underline"
            >
              {SITE.email}
            </a>
          </div>
          <ul class="mt-4 flex flex-wrap gap-4 text-sm text-muted">
            {
              SITE.socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    class="inline-block py-1 transition-colors hover:text-accent"
                    target={
                      social.href.startsWith("http") ? "_blank" : undefined
                    }
                    rel={
                      social.href.startsWith("http")
                        ? "noopener noreferrer"
                        : undefined
                    }
                  >
                    {social.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>