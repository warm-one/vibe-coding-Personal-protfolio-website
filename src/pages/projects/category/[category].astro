---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import FilterChips from "../../../components/FilterChips.astro";
import { getProjects } from "../../../lib/projects";
import { CATEGORIES, categoriesWithCounts, categoryHref } from "../../../lib/categories";

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.key },
  }));
}

const raw = Astro.params.category ?? "";
const current = CATEGORIES.find((category) => category.key === raw);

if (!current) {
  throw new Error(`Unknown category: ${raw}`);
}

const all = await getProjects();
const projects = all.filter((project) => project.data.type === current.key);

const chips = categoriesWithCounts(all)
  .filter((category) => category.count > 0)
  .map((category) => ({
    key: category.key,
    label: category.label,
    href: categoryHref(category.key),
  }));
---

<BaseLayout
  title={current.label}
  description={`${current.label}类的项目作品。`}
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
      {current.label}
    </h1>
    <p class="mt-4 text-muted">{current.blurb} · 共 {projects.length} 个</p>

    <div class="mt-6">
      <FilterChips items={chips} active={current.key} />
    </div>

    {
      projects.length > 0 ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {projects.map((project) => (
            <ProjectCard project={project} headingLevel="h2" />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-muted">这个分类下还没有作品。</p>
      )
    }
  </section>
</BaseLayout>
