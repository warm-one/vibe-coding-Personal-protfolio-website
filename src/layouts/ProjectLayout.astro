---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Tag from "../components/Tag.astro";
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
const { title, summary, cover, tags, links, gallery, date } = project.data;

const formattedDate = date.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={summary} image={cover.src}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <a
      href="/projects"
      class="text-sm text-muted transition-colors hover:text-accent"
    >
      ← 返回作品
    </a>

    <header class="mt-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-muted">{summary}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-muted">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {tags.map((tag) => <Tag label={tag} />)}
      </div>
      {
        (links.github || links.demo) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {links.github && (
              <a
                href={links.github}
                class="rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
              >
                GitHub
              </a>
            )}
            {links.demo && (
              <a
                href={links.demo}
                class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90"
              >
                在线 Demo
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      links.github ? (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`在 GitHub 上查看「${title}」`}
          class="mt-8 block overflow-hidden rounded-lg border border-border transition-colors hover:border-accent/60"
        >
          <Image
            src={cover}
            alt={title}
            width={800}
            height={450}
            class="aspect-[16/9] w-full object-cover"
          />
        </a>
      ) : (
        <Image
          src={cover}
          alt={title}
          width={800}
          height={450}
          class="mt-8 aspect-[16/9] w-full rounded-lg object-cover"
        />
      )
    }

    <div class="prose prose-invert mt-10 max-w-none">
      <slot />
    </div>

    {
      gallery.length > 0 && (
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {gallery.map((image, index) => (
            <Image
              src={image}
              alt={`${title} 截图 ${index + 1}`}
              width={800}
              height={450}
              class="rounded-lg"
            />
          ))}
        </div>
      )
    }

    <nav
      aria-label="项目导航"
      class="mt-12 flex items-center justify-between gap-4 border-t border-border pt-6 text-sm"
    >
      <div>
        {
          prev && (
            <a
              href={`/projects/${prev.id}`}
              class="text-muted transition-colors hover:text-accent"
            >
              ← {prev.data.title}
            </a>
          )
        }
      </div>
      <div class="text-right">
        {
          next && (
            <a
              href={`/projects/${next.id}`}
              class="text-muted transition-colors hover:text-accent"
            >
              {next.data.title} →
            </a>
          )
        }
      </div>
    </nav>
  </article>
</BaseLayout>
