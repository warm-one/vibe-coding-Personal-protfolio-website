---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Tag from "../components/Tag.astro";
import { SITE } from "../consts";
import { localizePath, useTranslations } from "../i18n/utils";
import { hreflang, type Lang } from "../i18n/ui";
import { projectTypeLabelKey } from "../lib/categories";
import { formatLongDate } from "../lib/format";
import type { LocalizedProject } from "../lib/projects";

interface Props {
  project: LocalizedProject;
  prev: LocalizedProject | null;
  next: LocalizedProject | null;
  lang: Lang;
}

const { project, prev, next, lang } = Astro.props;
const t = useTranslations(lang);
const { title, summary, cover, tags, links, gallery, date, embed, type } =
  project.entry.data;

const formattedDate = formatLongDate(date, lang);
const typeLabel = t(projectTypeLabelKey(type));
const coverExt = cover.src.split(".").pop()?.toLowerCase() ?? "";
const hasRasterCover = coverExt !== "svg";
const imageType = !hasRasterCover
  ? undefined
  : coverExt === "jpg" || coverExt === "jpeg"
    ? "image/jpeg"
    : `image/${coverExt}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description: summary,
  datePublished: date.toISOString(),
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL(cover.src, Astro.site).href,
  inLanguage: hreflang[lang],
  author: { "@type": "Person", name: SITE.name },
  ...(tags.length > 0 ? { keywords: tags.join(", ") } : {}),
  ...(links.github ? { codeRepository: links.github } : {}),
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={summary + " " + t("projectMetaSuffix")}
  image={hasRasterCover ? cover.src : undefined}
  imageWidth={hasRasterCover ? cover.width : undefined}
  imageHeight={hasRasterCover ? cover.height : undefined}
  imageType={imageType}
  type="article"
  publishedTime={date.toISOString()}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav
      aria-label={t("breadcrumbLabel")}
      class="flex flex-wrap items-center gap-2 text-sm text-muted"
    >
      <a
        href={localizePath("/", lang)}
        class="inline-block py-1 transition-colors hover:text-accent"
      >
        {t("navHome")}
      </a>
      <span aria-hidden="true">/</span>
      <a
        href={localizePath("/projects", lang)}
        class="inline-block py-1 transition-colors hover:text-accent"
      >
        {t("navProjects")}
      </a>
      <span aria-hidden="true">/</span>
      <span aria-current="page" class="text-foreground">{title}</span>
    </nav>

    <header class="mt-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-muted">{summary}</p>
      <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-muted">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span
          class="rounded-full border border-border bg-background/60 px-2.5 py-1 text-xs"
        >
          {typeLabel}
        </span>
        {tags.map((tag) => <Tag label={tag} />)}
      </div>
      {
        (links.github || links.demo) && (
          <div class="mt-6 flex flex-wrap gap-3">
            {links.github && (
              <a
                href={links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
              >
                {t("linkGithub")}
              </a>
            )}
            {links.demo && (
              <a
                href={links.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90"
              >
                {t("linkDemo")}
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      links.github ? (
        <a
          href={links.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={t("linkGithub") + " · " + title}
          class="mt-8 block overflow-hidden rounded-xl border border-border transition-colors hover:border-accent/60"
        >
          <Image
            src={cover}
            alt={title}
            width={800}
            height={450}
            widths={[600, 900]}
            sizes="(min-width: 768px) 768px, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-[16/9] w-full object-cover"
          />
        </a>
      ) : (
        <Image
          src={cover}
          alt={title}
          width={800}
          height={450}
          widths={[600, 900]}
          sizes="(min-width: 768px) 768px, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="mt-8 aspect-[16/9] w-full rounded-xl object-cover"
        />
      )
    }

    {
      embed && (
        <section class="mt-10">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-lg font-semibold">{t("tryIt")}</h2>
            <a
              href={embed}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block py-1 text-sm text-accent hover:underline"
            >
              {t("openInNewTab")} ↗
            </a>
          </div>
          <div class="mt-4 overflow-hidden rounded-xl border border-border bg-surface">
            <div
              data-demo-placeholder
              class="flex min-h-[220px] flex-col items-center justify-center gap-4 bg-background/40 px-6 py-10 text-center"
            >
              <p class="max-w-md text-sm text-muted">{t("tryItNote")}</p>
              <button
                type="button"
                data-demo-load
                data-src={embed}
                data-title={t("tryIt") + " · " + title}
                class="rounded-md bg-accent px-4 py-2 text-sm font-medium text-background transition-opacity hover:opacity-90"
              >
                {t("loadDemo")}
              </button>
            </div>
            <div data-demo-container hidden></div>
          </div>
        </section>
      )
    }

    {
      project.fallback && (
        <p class="mt-6 rounded-md border border-border bg-surface px-4 py-2 text-sm text-muted">
          {t("fallbackNotice")}
        </p>
      )
    }

    <div class="prose mt-10 max-w-none">
      <slot />
    </div>

    {
      gallery.length > 0 && (
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {gallery.map((image, index) => (
            <Image
              src={image}
              alt={title + " " + String(index + 1)}
              width={800}
              height={450}
              widths={[400, 800]}
              sizes="(min-width: 640px) 50vw, 100vw"
              decoding="async"
              class="rounded-lg"
            />
          ))}
        </div>
      )
    }

    {
      (prev || next) && (
        <nav
          aria-label={t("projectNav")}
          class="mt-12 grid gap-4 border-t border-border pt-6 sm:grid-cols-2"
        >
          <div>
            {prev && (
              <a
                href={localizePath("/projects/" + prev.slug, lang)}
                class="group block rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent/60"
              >
                <span class="text-[11px] tracking-[0.18em] text-muted uppercase">
                  {t("prevProject")}
                </span>
                <span class="mt-1 block font-medium transition-colors group-hover:text-accent">
                  {prev.entry.data.title}
                </span>
              </a>
            )}
          </div>
          <div class="sm:text-right">
            {next && (
              <a
                href={localizePath("/projects/" + next.slug, lang)}
                class="group block rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent/60"
              >
                <span class="text-[11px] tracking-[0.18em] text-muted uppercase">
                  {t("nextProject")}
                </span>
                <span class="mt-1 block font-medium transition-colors group-hover:text-accent">
                  {next.entry.data.title}
                </span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</BaseLayout>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-demo-load]");
    if (!button) return;

    button.addEventListener("click", () => {
      const src = button.getAttribute("data-src");
      const title = button.getAttribute("data-title") || "Demo";
      const container = document.querySelector("[data-demo-container]");
      if (!src || !container) return;

      const frame = document.createElement("iframe");
      frame.src = src;
      frame.title = title;
      frame.loading = "lazy";
      frame.className = "h-[70vh] min-h-[420px] max-h-[560px] w-full";
      container.appendChild(frame);
      container.hidden = false;

      const placeholder = button.closest("[data-demo-placeholder]");
      if (placeholder) placeholder.remove();
    });
  })();
</script>