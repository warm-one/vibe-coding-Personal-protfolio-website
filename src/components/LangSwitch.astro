---
import { languages, type Lang } from "../i18n/ui";
import { getAlternatePath, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === "zh" ? "en" : "zh";
const href = getAlternatePath(Astro.url, other);
---

<a
  href={href}
  hreflang={other}
  lang={other}
  aria-label={`${t("langSwitch")}：${languages[other]}`}
  class="inline-flex h-8 shrink-0 items-center rounded-md border border-border px-2.5 text-xs whitespace-nowrap text-muted transition-colors hover:border-accent/60 hover:text-foreground"
>
  {languages[other]}
</a>
