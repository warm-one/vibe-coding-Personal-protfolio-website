---
import {
  categoryBlurbKey,
  categoryHref,
  categoryLabelKey,
  type Category,
} from "../lib/categories";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

interface Item extends Category {
  count: number;
}

interface Props {
  lang: Lang;
  items: Item[];
}

const { lang, items } = Astro.props;
const t = useTranslations(lang);

const cols =
  items.length >= 3
    ? "sm:grid-cols-3"
    : items.length === 2
      ? "sm:grid-cols-2"
      : "";
---

<div
  class:list={[
    "mt-8 grid divide-y divide-border overflow-hidden rounded-xl border border-border sm:divide-x sm:divide-y-0",
    cols,
  ]}
>
  {
    items.map((item, index) => (
      <a
        href={categoryHref(item.key, lang)}
        class="group flex items-center justify-between gap-4 bg-surface p-5 transition-colors hover:bg-background sm:p-6"
      >
        <span class="flex items-center gap-4">
          <span class="text-[11px] tabular-nums text-muted" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span>
            <span class="block text-lg font-medium group-hover:text-accent">
              {t(categoryLabelKey(item.key))}
            </span>
            <span class="mt-1 block text-sm text-muted">
              {t(categoryBlurbKey(item.key))}
            </span>
          </span>
        </span>
        <span class="flex shrink-0 items-center gap-3 text-sm tabular-nums text-muted">
          {item.count}
          <span
            class="transition-transform motion-safe:group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            →
          </span>
        </span>
      </a>
    ))
  }
</div>
