---
import { Image } from "astro:assets";
import { SITE } from "../consts";
import type { LocalizedProject } from "../lib/projects";
import { localizePath, useTranslations } from "../i18n/utils";
import { projectTypeLabelKey } from "../lib/categories";
import { formatMonth } from "../lib/format";
import type { Lang } from "../i18n/ui";

interface Props {
  project: LocalizedProject;
  lang: Lang;
  class?: string;
}

const { project, lang, class: className } = Astro.props;
const { title, cover, type, date } = project.entry.data;
const t = useTranslations(lang);
const href = localizePath("/projects/" + project.slug, lang);
const typeLabel = t(projectTypeLabelKey(type));
---

<a
  href={href}
  class:list={[
    "group relative block overflow-hidden rounded-2xl border border-border bg-surface shadow-lg",
    className,
  ]}
  aria-label={title + " — " + typeLabel}
>
  <div
    class="flex items-center gap-1.5 border-b border-border/70 px-4 py-3"
    aria-hidden="true"
  >
    <span class="h-2 w-2 rounded-full bg-muted/40"></span>
    <span class="h-2 w-2 rounded-full bg-muted/40"></span>
    <span class="h-2 w-2 rounded-full bg-muted/40"></span>
    <span class="ml-2 min-w-0 truncate text-[11px] text-muted"
      >{SITE.name} · /projects/{project.slug}</span
    >
    <span class="ml-auto shrink-0 text-[11px] text-muted">↗</span>
  </div>
  <div class="relative aspect-[16/10] overflow-hidden bg-background">
    <Image
      src={cover}
      alt=""
      width={800}
      height={500}
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 38vw, (min-width: 640px) 80vw, 100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:group-hover:scale-[1.02]"
    />
    <span
      class="absolute right-3 top-3 rounded-full border border-border/70 bg-background/85 px-2.5 py-1 text-[11px] font-medium text-foreground backdrop-blur"
    >
      {typeLabel}
    </span>
  </div>
  <div class="flex items-end justify-between gap-4 p-4 sm:p-5">
    <div class="min-w-0">
      <p class="text-[11px] tracking-[0.18em] text-muted uppercase">
        {formatMonth(date)}
      </p>
      <p
        class="mt-1 truncate text-lg font-semibold tracking-tight transition-colors group-hover:text-accent"
      >
        {title}
      </p>
    </div>
    <span
      class="shrink-0 text-sm text-muted transition-transform motion-safe:group-hover:translate-x-0.5"
      aria-hidden="true">→</span
    >
  </div>
</a>