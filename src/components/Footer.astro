---
import { SITE } from "../consts";

const year = new Date().getFullYear();
---

<footer class="border-t border-border/60">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>© {year} {SITE.name}</p>
    <ul class="flex items-center gap-4">
      {
        SITE.socials.map((social) => (
          <li>
            <a
              href={social.href}
              class="transition-colors hover:text-foreground"
            >
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
