---
import { SITE } from "../consts";
---

<header
  class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur"
>
  <nav
    aria-label="主导航"
    class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6"
  >
    <a href="/" class="font-semibold tracking-tight">{SITE.name}</a>
    <ul class="flex items-center gap-4 text-sm text-muted">
      {
        SITE.nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="transition-colors hover:text-foreground"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
