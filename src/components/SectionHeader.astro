---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  index?: string;
  class?: string;
}

const { title, href, linkLabel, index, class: className } = Astro.props;
---

<div class:list={["flex items-end justify-between gap-4", className]}>
  <div class="min-w-0">
    <div class="flex items-center gap-3">
      {index && (
        <span class="text-[11px] tabular-nums text-muted" aria-hidden="true">
          {index}
        </span>
      )}
      <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
    </div>
    <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">
      {title}
    </h2>
  </div>
  {
    href && linkLabel && (
      <a
        href={href}
        class="group inline-flex shrink-0 items-center gap-1 py-1 text-sm text-muted transition-colors hover:text-accent"
      >
        {linkLabel}
        <span
          class="transition-transform motion-safe:group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    )
  }
</div>
